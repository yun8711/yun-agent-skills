# 复制为 .env.e2e 后按需调整。该文件已在 .gitignore，禁止提交。

# ---------- 入口 ----------
E2E_ENTRY=host
# E2E_BASE_URL=http://localhost:8001
# E2E_HOST_PORT=8001
# E2E_APP_PREFIX=/xxx   # 默认 vue.custom.js name → /{name}


# ---------- 登录（主应用 /login，配齐即可自动登录）----------
E2E_AUTH_MODE=ui
E2E_USERNAME=your-account
E2E_PASSWORD=your-password
# 有图形验证码时会尝试识图填写；若环境强制改密/踢人需人工处理
# 登录成功会写入 e2e/.auth/storage-state.json，下次有效则跳过登录
# E2E_FORCE_LOGIN=1
# 本地默认弹出浏览器；不要界面时：E2E_HEADLESS=1
# 放慢操作（毫秒）：E2E_SLOW_MO=500
# 接口录制：默认开；关：E2E_API_RECORD=0；带响应体摘要：E2E_API_RECORD_BODY=1

# ---------- Midscene 模型（对齐本机 Codex：gpt-5.4）----------
E2E_MODEL_PROVIDER=codex
MIDSCENE_MODEL_NAME=gpt-5.4
MIDSCENE_MODEL_FAMILY=gpt-5

# PW_TEST_SCREENSHOT_NO_FONTS_READY=1
