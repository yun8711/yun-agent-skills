{
  "version": "1.0",
  "description": "前端部署自动化配置文件模板",

  "bastion": {
    "host": "192.168.12.100",
    "port": 2222,
    "user": "liuyun",
    "auth_method": "password",
    "password": null,
    "password_env_var": "DEPLOY_PASSWORD",
    "connection_timeout": 30,
    "description": "堡垒机配置（仅支持密码认证）"
  },

  "projects": {
    "rhea": {
      "build_param": "build",
      "deploy_path": "/data/application/qiankun/subapp/rhea/",
      "server_pattern": "12.168",
      "backup_old_version": true,
      "post_deploy_commands": [
        "ls -la",
        "echo 'Deploy completed successfully'"
      ],
      "description": "Rhea微服务前端项目"
    },

    "qiankun": {
      "build_param": "production",
      "deploy_path": "/data/application/qiankun/main/",
      "server_pattern": "12.168",
      "backup_old_version": true,
      "post_deploy_commands": [
        "systemctl restart nginx",
        "echo 'Main app deployed'"
      ],
      "description": "Qiankun主应用"
    }
  },

  "environments": {
    "dev": {
      "server_pattern": "12.168",
      "description": "开发环境"
    },
    "test": {
      "server_pattern": "12.169",
      "description": "测试环境"
    },
    "prod": {
      "server_pattern": "12.170",
      "description": "生产环境"
    }
  },

  "deployment": {
    "max_retries": 3,
    "retry_delay": 5,
    "timeout": 300,
    "cleanup_temp_files": true,
    "log_level": "info",
    "enable_progress_bar": true
  },

  "security": {
    "encrypt_passwords": true,
    "password_env_var": "DEPLOY_PASSWORD",
    "ssh_key_passphrase_env_var": "SSH_KEY_PASSPHRASE",
    "allowed_ips": ["192.168.12.100"],
    "enable_audit_log": true
  },

  "notifications": {
    "enable": false,
    "type": "email",
    "recipients": ["dev-team@company.com"],
    "on_success": true,
    "on_failure": true
  },

  "advanced": {
    "custom_build_command": null,
    "pre_deploy_hooks": [],
    "post_deploy_hooks": [],
    "rollback_strategy": "backup",
    "health_check_url": null,
    "health_check_timeout": 30
  }
}