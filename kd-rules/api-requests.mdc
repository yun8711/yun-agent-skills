# API 请求规范

## API 文件组织

API 接口定义在 `src/server/` 目录下，按业务模块组织文件：

```
src/server/
├── api-manage.js      # API 管理相关接口
├── app-manage.js      # 应用管理相关接口
├── data-source.js     # 数据源相关接口
└── ...
```

## 定义 API 方法

### 基本规范

- 使用 `@/utils/request` 工具进行请求
- 每个 API 方法尽量添加 JSDoc 注释
- 使用命名导出（`export function`）
- 方法名使用 camelCase，动词开头（如 `queryList`、`createItem`、`updateItem`、`deleteItem`）

### GET 请求

```javascript
/**
 * @desc 获得API基本信息
 * @param {string} [id] - id
 * @returns {Promise<any>}
 */
export function getApiBaseInfo(id) {
  return request({
    url: "/api/api/baseInfo",
    params: { id },
  });
}
```

### POST 请求

```javascript
/**
 * @desc 新增Api
 * @param {object} json - json
 * @returns {Promise<any>}
 */
export function createApi(json) {
  return request({
    url: "/api/api",
    method: "post",
    data: json,
  });
}
```

### PUT 请求

```javascript
/**
 * @desc 修改API信息
 * @param {object} data - json
 * @returns {Promise<any>}
 */
export function updateApiVersionInfo(data) {
  return request({
    url: "/api/api",
    method: "put",
    data,
  });
}
```

### DELETE 请求

```javascript
/**
 * @desc 删除某个API版本信息
 * @param {string} id - apiid
 * @returns {Promise<any>}
 */
export function deleteApiVersion(id) {
  return request({
    url: "/api/api",
    method: "delete",
    params: { id },
  });
}
```

### 文件下载

```javascript
/**
 * @desc 导出文件
 * @param {object} params - 查询参数
 * @returns {Promise<any>}
 */
export function downloadFile(params) {
  return request({
    url: "/api/api/export",
    method: "get",
    params,
    download: true,
    fileName: "导出文件",
    fileType: "xlsx",
  });
}
```

## 在组件中使用

### 基本用法

```javascript
import { queryList, createItem, updateItem, deleteItem } from "@/server/api-module";

export default {
  methods: {
    async queryList() {
      try {
        const params = {
          projectId: this.curProjectId,
          pageNum: this.pageConf.currentPage,
          pageSize: this.pageConf.pageSize,
        };
        const res = await queryList(params);
        this.tableData = res.list || [];
        this.pageConf.total = res.total || 0;
      } catch (error) {
        this.$message.error("获取列表失败");
      }
    },
    async handleCreate() {
      try {
        const params = {
          ...this.formData,
          projectId: this.curProjectId,
        };
        await createItem(params);
        this.$message.success("创建成功");
        this.queryList();
      } catch (error) {
        // 错误信息已由 request 拦截器自动显示
      }
    },
  },
};
```

### 错误处理

```javascript
// ❌ BAD - 不处理错误
async handleDelete() {
  await deleteItem(id);
}

// ✅ GOOD - 使用 try-catch 处理错误
async handleDelete() {
  try {
    await deleteItem(id);
    this.$message.success("删除成功");
    this.queryList();
  } catch (error) {
    // 错误信息已由 request 拦截器自动显示，这里可以添加额外处理
    console.error("删除失败", error);
  }
}

// ✅ GOOD - 需要自定义错误提示时，设置 showError: false
async handleDelete() {
  try {
    await deleteItem(id);
    this.$message.success("删除成功");
    this.queryList();
  } catch (error) {
    this.$message.error("删除失败，请重试");
  }
}
```

## 请求配置说明

### 基本配置

```javascript
request({
  url: "/api/path",              // 请求地址（必需）
  method: "get",                 // 请求方法：get | post | put | delete（默认：get）
  params: {},                    // URL 参数（GET 请求使用）
  data: {},                      // 请求体（POST/PUT 请求使用）
  headers: {},                    // 自定义请求头
});
```

### 高级配置

```javascript
request({
  url: "/api/path",
  method: "post",
  data: {},
  download: false,               // 是否为文件下载（默认：false）
  fileName: "",                  // 下载的文件名（download 为 true 时使用）
  fileType: "",                  // 下载的文件类型（download 为 true 时使用）
  showError: true,               // 是否显示错误提示（默认：true）
  repeat: true,                  // 是否允许重复请求（默认：true）
  abort: false,                  // 是否需要取消请求操作（默认：false）
  resPath: "data.data",          // 成功响应数据路径（可选）
  errorPath: "data.errorMessage", // 错误响应数据路径（可选）
});
```

### 简化 GET 请求

```javascript
// 简化写法：直接传入 URL 字符串
export function getApiInfo(id) {
  return request(`/api/api/info?id=${id}`);
}

// 标准写法：使用配置对象
export function getApiInfo(id) {
  return request({
    url: "/api/api/info",
    params: { id },
  });
}
```

## 请求拦截器

请求拦截器会自动添加以下请求头：

- `tenantId`: 从 `localStorage.getItem("tenantId")` 获取
- `projectId`: 从 `sessionStorage.getItem("projectId")` 获取
- `menuKey`: 从当前路由 `router.currentRoute?.meta?.menuKey` 获取

## 响应处理

### 成功响应

- 默认返回 `response.data` 中的数据
- 可通过 `resPath` 配置指定返回数据的路径（如 `"data.list"`）

### 错误响应

- 默认自动显示错误提示（通过 `this.$message.error`）
- 可通过 `showError: false` 关闭自动错误提示
- 错误信息路径可通过 `errorPath` 配置（默认：`"data.errorMessage"`）

### 文件下载

- 设置 `download: true` 或 `responseType: "blob"` 时，自动处理文件下载
- 需要指定 `fileName` 和 `fileType`

## 请求取消

### 手动取消请求

```javascript
// 设置 abort: true 可以获取 AbortController 手动取消请求
export function queryList(params) {
  const [promise, controller] = request({
    url: "/api/api/list",
    params,
    abort: true,
  });

  // 保存 controller，需要时调用 controller.abort() 取消请求
  return promise;
}
```

## 文件上传

```javascript
/**
 * @desc 上传文件
 * @param {FormData} formData - 表单数据
 * @returns {Promise<any>}
 */
export function uploadFile(formData) {
  return request({
    url: "/api/api/upload",
    method: "post",
    data: formData,
    headers: {
      "content-type": "multipart/form-data",
    },
  });
}
```

## 注意事项

1. **参数命名**：
   - query 参数使用 `params`
   - POST/PUT 请求的 body 参数使用 `data`

2. **错误处理**：
   - 默认情况下，错误会自动显示，无需手动处理
   - 需要自定义错误提示时，设置 `showError: false` 并在 catch 中处理

3. **JSDoc 注释**：
   - 每个 API 方法必须添加 `@desc` 描述
   - 参数使用 `@param {type} [name] - description` 格式（可选参数用 `[]` 包裹）
   - 返回值使用 `@returns {Promise<any>}`

4. **文件组织**：
   - 按业务模块组织 API 文件
   - 文件名使用 kebab-case（如 `api-manage.js`）
